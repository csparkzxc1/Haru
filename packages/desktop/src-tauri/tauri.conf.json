{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "하루",
  "version": "0.1.0",
  "identifier": "kr.haru.app",
  "build": {
    "frontendDist": null,
    "devUrl": "https://haru.vercel.app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "하루",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "url": "https://haru.vercel.app/today",
        "fileDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' https://haru.vercel.app https://haru-backend.onrender.com 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: https:; connect-src 'self' https://haru-backend.onrender.com"
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Haru",
    "category": "Productivity",
    "shortDescription": "한국형 To-Do",
    "longDescription": "Things의 미니멀 철학에 한국 문화(음력·공휴일·경조사)를 더한 할 일 관리 앱"
  },
  "plugins": {}
}
