# 하루 백엔드 환경변수.
# 이 파일을 .env 로 복사 후 값을 채워 사용하세요. 절대 커밋 금지.

# ---- 필수 ----

# Neon 또는 다른 Postgres. SSL 강제 권장.
DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/haru?sslmode=require"

# 충분히 긴 무작위 시크릿. 운영 전 반드시 교체.
#   생성: openssl rand -base64 48
JWT_SECRET="change-me-to-something-long-and-random"

# 콤마 구분. 모바일 dev 서버 IP도 포함시켜야 한다.
#   예: https://haru.vercel.app,http://localhost:3000,http://192.168.0.10:8081
CORS_ORIGIN="http://localhost:3000"

# iCal 구독 URL 생성 등에 사용.
PUBLIC_BASE_URL="http://localhost:3001/api"

# ---- 액세스 토큰 ----

JWT_ACCESS_TTL="15m"

# ---- 서버 ----

PORT=3001
NODE_ENV=development

# ---- 카카오 OAuth (선택) ----
# https://developers.kakao.com 에서 앱 생성 후 REST API 키.
# 미설정 시 /api/auth/kakao 라우트는 503 반환.
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# KAKAO_CALLBACK_URL=http://localhost:3001/api/auth/kakao/callback
# WEB_AUTH_REDIRECT=http://localhost:3000/auth/callback

# ---- 외부 캘린더 (선택) ----
# GOOGLE_CLIENT_ID=
# NAVER_CLIENT_ID=

# ---- AI 어시스턴트 (선택) ----
# https://console.anthropic.com 에서 발급. 미설정 시 /api/ai/* 는 503.
# 모델: claude-sonnet-4-6 (서비스에서 하드코딩, 비용 균형)
# ANTHROPIC_API_KEY=
