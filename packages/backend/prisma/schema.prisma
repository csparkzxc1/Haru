// 하루 데이터 모델
// Postgres + Prisma. 사용자·Area·Project·Task·Tag·Checklist·Share.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum SocialProvider {
  KAKAO
  NAVER
  APPLE
  GOOGLE
  EMAIL
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  passwordHash  String?
  nickname      String
  timezone      String    @default("Asia/Seoul")
  locale        String    @default("ko-KR")
  avatarUrl     String?
  plan          String    @default("free") // free | pro | team
  // 개인정보보호
  marketingOptIn      Boolean  @default(false)
  marketingOptInAt    DateTime?
  privacyAgreedAt     DateTime
  termsAgreedAt       DateTime
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  socials       SocialAccount[]
  areas         Area[]
  projects      Project[]
  tasks         Task[]
  tags          Tag[]
  memberships   AreaMember[]
  sessions      Session[]
  pushTokens    PushToken[]
  familyEvents  FamilyEvent[]
  notificationPreference NotificationPreference?
}

model SocialAccount {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   SocialProvider
  providerId String
  createdAt  DateTime       @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash  String
  deviceLabel  String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Area {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title     String
  colorHex  String   @default("#1C1C1E")
  icon      String?
  shared    Boolean  @default(false)
  sortOrder Int      @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  tasks     Task[]
  members   AreaMember[]
  invites   AreaInvite[]

  @@index([ownerId])
}

model AreaMember {
  id       String   @id @default(uuid())
  areaId   String
  area     Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // owner | member | viewer
  invitedAt DateTime @default(now())
  joinedAt  DateTime?

  @@unique([areaId, userId])
  @@index([userId])
}

/// Area 초대 코드. 공유 URL 또는 카카오톡 메시지로 전달.
model AreaInvite {
  id         String   @id @default(uuid())
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  /// URL-safe 랜덤 토큰. 일회용.
  token      String   @unique
  invitedBy  String
  /// 만료. 기본 7일.
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?
  createdAt  DateTime @default(now())

  @@index([areaId])
}

model Project {
  id        String     @id @default(uuid())
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  title     String
  notes     String?    @db.Text
  deadline  DateTime?
  status    TaskStatus @default(OPEN)
  sortOrder Int        @default(0)
  completedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tasks     Task[]

  @@index([ownerId])
  @@index([areaId])
}

model Task {
  id          String      @id @default(uuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  areaId      String?
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)

  title       String
  notes       String?     @db.Text
  status      TaskStatus  @default(OPEN)
  /// 예정 시각 (오늘 뷰 표시 기준)
  when        DateTime?
  /// 마감 시각
  deadline    DateTime?
  allDay      Boolean     @default(true)

  // 반복 규칙 (직렬화)
  recurrenceJson Json?

  sortOrder   Int         @default(0)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /// 동기화용 단조 증가 버전. update 시 +1. 클라이언트는 LWW 판정에 활용.
  version     Int         @default(1)
  /// 소프트 삭제 — 다른 기기가 변경 피드로 삭제 사실을 받을 수 있어야 함.
  deletedAt   DateTime?

  checklistItems ChecklistItem[]
  taskTags       TaskTag[]

  @@index([ownerId, status, when])
  @@index([ownerId, updatedAt])
  @@index([projectId])
  @@index([areaId])
}

/// Expo Push 등록 토큰. 사용자 1명이 여러 기기를 가질 수 있다.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "expo" | "fcm" | "apns" — v1은 expo만 지원.
  platform   String   @default("expo")
  token      String   @unique
  deviceLabel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime?

  @@index([userId])
}

model ChecklistItem {
  id       String  @id @default(uuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title    String
  done     Boolean @default(false)
  sortOrder Int    @default(0)

  @@index([taskId])
}

model Tag {
  id       String    @id @default(uuid())
  ownerId  String
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  colorHex String?
  createdAt DateTime @default(now())

  taskTags TaskTag[]

  @@unique([ownerId, name])
}

model TaskTag {
  taskId  String
  tagId   String
  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag     Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model NotificationPreference {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  push         Boolean  @default(true)
  kakaoAlimtalk Boolean @default(false)
  quietStart   String   @default("22:00")
  quietEnd     String   @default("07:00")
  dailyDigest  Boolean  @default(true)
  digestHour   Int      @default(8)
}

enum FamilyEventKind {
  WEDDING       // 결혼
  FUNERAL       // 장례
  BIRTHDAY      // 생일
  ANNIVERSARY   // 기념일
  BABY_100D     // 백일
  BABY_DOL      // 돌
  HOUSEWARMING  // 집들이
  PROMOTION     // 승진
  OTHER
}

/// 경조사 — 일정·축의금·축전 한 번에 관리. 한국 직장인의 빈번한 부담.
model FamilyEvent {
  id           String           @id @default(uuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind         FamilyEventKind
  /// 누구의 (예: "김부장 자녀")
  personLabel  String
  /// 관계 (예: "회사 상사", "친구", "가족")
  relation     String?
  date         DateTime
  venue        String?
  /// 보낸 금액 (원). null = 미정 / 0 = 안 함
  amountKrw    Int?
  /// 받은 금액 (역경조사 추적)
  receivedKrw  Int?
  notes        String?          @db.Text
  /// 참석 여부
  attended     Boolean?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId, date])
}

/** 감사 로그 — 개인정보보호법 대응 */
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
