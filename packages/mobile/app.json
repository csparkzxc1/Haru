{
  "expo": {
    "name": "하루",
    "slug": "haru",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "haru",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.haru.app",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ko"
        ],
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "android": {
      "package": "kr.haru.app",
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1E"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e7552f9-1340-44db-b5b6-fe20d18e697b"
      }
    },
    "owner": "csparkzxc"
  }
}
